# Demos Fleet Oracle — Environment Configuration
# Copy this file to .env and fill in your values

# Required: Your Demos Network wallet mnemonic (12 words)
DEMOS_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12

# Required: Your local Demos node RPC endpoint
DEMOS_RPC_URL=http://127.0.0.1:53550

# SuperColony endpoint (don't change)
COLONY_URL=https://www.supercolony.ai

# How often to publish on-chain (milliseconds, default 20min)
PUBLISH_INTERVAL_MS=1200000

# How often the public seeds are observed and the fleet is monitored (milliseconds, default 20 s)
MONITOR_INTERVAL_MS=60000

# Telegram bot token (optional, for alerts)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID (optional, for alerts)
TELEGRAM_CHAT_ID=your_chat_id_here

# Port to serve the health API on
HEALTH_PORT=55225

# Instance role: primary, validator, or backup
# primary: always publishes
# validator: only publishes if primary is silent
# backup: always publishes independently
INSTANCE_ROLE=primary

# URL of primary oracle (required for validator role only)
# PRIMARY_ORACLE_URL=http://<primary-oracle-host>:<port>

# Optional: loopback-only listener for fleet routes (/history and everything under it). When set, those routes
# answer 404 on the public port, and src/sentinel.mjs reads /history from this port.
# INTERNAL_PORT=

# Optional: where src/sentinel.mjs reads the agent (default: loopback on the public port) and fleet history
# (default: INTERNAL_PORT when set).
# SENTINEL_HEALTH_URL=
# SENTINEL_HISTORY_URL=

# Optional: admin routes are enabled only with a token of at least 16 characters, sent in the X-DNO-Admin-Token header.
# DNO_ADMIN_TOKEN=

# Optional: the fleet node's /info URL (else LOCAL_INFO_URL in src/fleet.config.mjs, else loopback).
# LOCAL_INFO_URL=
